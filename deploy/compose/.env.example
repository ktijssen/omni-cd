# ============================================================
# .env.example — copy to .env and fill in your values
# ============================================================

# ── Omni connection ───────────────────────────────────────────────────────────
OMNI_ENDPOINT=https://your-omni-instance.example.com
OMNI_SERVICE_ACCOUNT_KEY=

# ── Sync settings ─────────────────────────────────────────────────────────────
# How often (in seconds) OmniCD polls git for new commits (default: 300)
REFRESH_INTERVAL=300

# ── Authentication ────────────────────────────────────────────────────────────
# ADMIN_PASSWORD is required unless AUTH_DISABLED=true or you use the /setup wizard
ADMIN_PASSWORD=changeme!
AUTH_DISABLED=false

# ── Web UI ────────────────────────────────────────────────────────────────────
WEB_PORT=8080

# ── Logging (DEBUG, INFO, WARN, ERROR) ────────────────────────────────────────
LOG_LEVEL=INFO

# ── OIDC / Single Sign-On (optional) ─────────────────────────────────────────
# Enable SSO by setting at minimum OIDC_ISSUER_URL and OIDC_CLIENT_ID.
# When enabled, a "Sign in with SSO" button appears on the login page.
#
# OIDC_ISSUER_URL=https://accounts.example.com
# OIDC_CLIENT_ID=omni-cd
# OIDC_CLIENT_SECRET=
#
# Callback URL registered with your IdP.
# Leave empty to auto-derive from the incoming request (recommended).
# OIDC_REDIRECT_URL=
#
# Space/comma-separated scopes (default: openid email profile)
# OIDC_SCOPES=openid,email,profile
#
# JWT/userinfo claim that contains group memberships (default: groups)
# OIDC_GROUPS_CLAIM=groups
#
# Role mapping — checked in order: admin emails > admin groups > viewer emails > viewer groups > default role
# OIDC_ADMIN_GROUPS=platform-admins,devops
# OIDC_ADMIN_EMAILS=alice@example.com
# OIDC_VIEWER_GROUPS=developers
# OIDC_VIEWER_EMAILS=bob@example.com
#
# Role assigned when no rule matches (admin | viewer | none — default: viewer)
# OIDC_DEFAULT_ROLE=viewer
#
# Set to true only for self-signed / internal IdP certificates
# OIDC_INSECURE=false