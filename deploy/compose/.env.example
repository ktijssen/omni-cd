# ============================================================
# .env.example — copy to .env and fill in your values
# ============================================================

# ── Omni connection ───────────────────────────────────────────────────────────
OMNI_ENDPOINT=https://your-omni-instance.example.com
OMNI_SERVICE_ACCOUNT_KEY=

# ── Sync settings ─────────────────────────────────────────────────────────────
# How often (in seconds) OmniCD polls git for new commits (default: 300)
REFRESH_INTERVAL=300

# ── Authentication ────────────────────────────────────────────────────────────
# ADMIN_PASSWORD is required unless AUTH_DISABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme!
AUTH_DISABLED=false

# ── Web UI ────────────────────────────────────────────────────────────────────
WEB_PORT=8080

# ── Logging (DEBUG, INFO, WARN, ERROR) ────────────────────────────────────────
LOG_LEVEL=INFO